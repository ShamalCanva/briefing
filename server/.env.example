# Copy to .env for local dev. In production every value comes from the platform secret manager.
# Nothing in this file is ever sent to the browser.

PORT=8080
PUBLIC_URL=https://brief.example.com
TIMEZONE=Australia/Sydney
ALLOWED_EMAILS=shamal@canva.com

# Shared secret the scheduler sends in `x-job-secret` to POST /jobs/generate
JOB_SECRET=

# 32-byte base64 key used to AES-GCM encrypt stored OAuth tokens
TOKEN_ENCRYPTION_KEY=

DATABASE_URL=postgres://user:pass@host:5432/brief

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google Cloud project, consent screen = Internal. One client serves Gmail, Calendar, Drive and the site sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Slack app (user-token OAuth v2). Needs workspace admin approval for the read-only scopes.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# GitHub App (user-to-server tokens)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Figma OAuth app
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=
